PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
# Optional: set custom DNS servers only if your network requires them.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
# Optional fallback for networks that block direct DNS requests to MongoDB Atlas.
# Uses Google DNS-over-HTTPS while preserving MongoDB TLS hostname verification.
# MONGODB_DNS_OVER_HTTPS=true
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
APP_URL=http://localhost:3000
MAIL_FROM=CareerConnect <no-reply@example.com>
RESEND_API_KEY=
